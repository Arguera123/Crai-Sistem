# ============================================================
# Plantilla de variables de entorno - CRAI Sistem
# Copie este archivo como ".env" en la raiz del proyecto y
# complete los valores. NUNCA suba el archivo .env al repositorio.
# ============================================================

# --- CONFIGURACION GLOBAL ---
DOMAIN_NAME=biblioteca.uca.edu.sv
NODE_ENV=production

# --- BASE DE DATOS (POSTGRESQL) ---
# DB_HOST debe ser "db" (nombre del servicio en docker-compose)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=biblioteca_admin
DB_PASSWORD=cambiame_por_un_password_seguro_123
DB_NAME=biblioteca_db

# --- BACKEND ---
BACKEND_PORT=5000
# URL publica del frontend (CORS y redireccion despues del login con Microsoft)
FRONTEND_URL=https://biblioteca.uca.edu.sv
# URL publica del backend, se antepone a las fotos guardadas localmente (/uploads/...)
API_URL=https://biblioteca.uca.edu.sv/api

# Secreto para firmar los JWT. Use una cadena larga y aleatoria, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=
# Duracion del token (formato de jsonwebtoken: 1d, 12h, 30m...)
TOKEN_EXP=1d

# Usuario administrador inicial que se crea al arrancar. Use un correo
# institucional real (el de la persona responsable del sistema).
ADMIN_ID=admin01
ADMIN_EMAIL=admin@example.com

# Inicio de sesion temporal solo con correo. Pongalo en "false" en produccion
# una vez que el inicio de sesion con Microsoft este funcionando.
ENABLE_EMAIL_LOGIN=true

# --- MICROSOFT (Azure AD / Entra ID) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Debe coincidir EXACTAMENTE con la URL registrada en Azure
MICROSOFT_CALLBACK_URL=https://biblioteca.uca.edu.sv/api/v1/auth/microsoft/callback

# --- API INSTITUCIONAL UCA (sincronizacion de usuarios) ---
UCA_API=
UCA_TOKEN=

# --- CORREO (recordatorios diarios de prestamos) ---
OUTLOOK_USER=
OUTLOOK_PASSWORD=

# --- FRONTEND (se inyecta al compilar) ---
# Debe terminar en /api/v1
VITE_API_URL=https://biblioteca.uca.edu.sv/api/v1
